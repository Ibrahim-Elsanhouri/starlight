<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pivot View -->
    <record id="view_custom_analytic_report_pivot" model="ir.ui.view">
        <field name="name">custom.analytic.report.pivot</field>
        <field name="model">custom.analytic.report</field>
        <field name="arch" type="xml">
            <pivot string="تقرير المبيعات والمشتريات التحليلي">
                <field name="analytic_account_id" type="row"/>
                <field name="doc_type" type="col"/>
                <field name="price_subtotal" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="view_custom_analytic_report_graph" model="ir.ui.view">
        <field name="name">custom.analytic.report.graph</field>
        <field name="model">custom.analytic.report</field>
        <field name="arch" type="xml">
            <graph string="مقارنة المبيعات والمشتريات التحليلية" type="bar">
                <field name="analytic_account_id"/>
                <field name="doc_type"/>
                <field name="price_subtotal" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Action -->
    <record id="action_custom_analytic_report" model="ir.actions.act_window">
        <field name="name">تقرير البنود التحليلي (مبيعات ومشتريات)</field>
        <field name="res_model">custom.analytic.report</field>
        <field name="view_mode">pivot,graph</field>
    </record>

    <!-- Menu Item under Sales -> Reporting -->
    <menuitem id="menu_custom_analytic_report_sales"
              name="التقرير التحليلي للبنود"
              parent="sale.menu_sale_report"
              action="action_custom_analytic_report"
              sequence="50"/>

    <!-- Menu Item under Purchase -> Reporting -->
    <menuitem id="menu_custom_analytic_report_purchase"
              name="التقرير التحليلي للبنود"
              parent="purchase.purchase_report"
              action="action_custom_analytic_report"
              sequence="50"/>
</odoo>